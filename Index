<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Keuangan Y &amp; D - Kelola Uang Masuk &amp; Keluar (Online Google Sheets)</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 999px;
        }
        .modal-animate {
            animation: modalFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.96) translateY(8px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
    </style>
</head>
<body id="appBody" class="bg-slate-900 text-slate-100 min-h-screen pb-16 antialiased relative overflow-x-hidden">

    <canvas id="bgCanvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

    <div id="authGate" class="fixed inset-0 z-50 bg-slate-950/85 backdrop-blur-md flex items-center justify-center p-4">
        <div class="bg-white text-slate-800 rounded-2xl max-w-sm w-full p-6 shadow-2xl modal-animate border border-slate-100 relative z-10">
            <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center mb-4 text-xl shadow-inner">
                <i class="fa-solid fa-user-lock"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-900">Autentikasi Penginput</h3>
            <p class="text-xs text-slate-500 mt-1 mb-4">Pilih akun dan masukkan kata sandi untuk mengakses perangkat ini.</p>

            <form onsubmit="saveDeviceEmail(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Pilih Akun / Email <span class="text-rose-500">*</span></label>
                    <select id="deviceEmailSelect" required class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:border-emerald-500 bg-white">
                        <option value="" disabled selected>-- Pilih Akun --</option>
                        <option value="DewiPurwanti.id">DewiPurwanti.id</option>
                        <option value="AhmadYunus.id">AhmadYunus.id</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Kata Sandi <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <input type="password" id="devicePasswordInput" required placeholder="Masukkan kata sandi..." class="w-full px-3 py-2 pr-10 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 focus:outline-none focus:border-emerald-500 bg-white">
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 focus:outline-none text-xs" title="Tampilkan/Sembunyikan Sandi">
                            <i id="togglePasswordIcon" class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>
                <div class="pt-2 flex justify-end gap-2">
                    <button type="button" onclick="exitApp()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold rounded-xl transition">Batal</button>
                    <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-md transition">Verifikasi &amp; Masuk</button>
                </div>
            </form>
        </div>
    </div>

    <div id="mainAppContent" class="hidden opacity-0 transition-opacity duration-500">
        <header class="bg-white/90 backdrop-blur-md border-b border-slate-200 sticky top-0 z-30 shadow-sm text-slate-800">
            <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-2 flex-wrap">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-lg font-bold shadow-md shadow-emerald-200">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <div>
                        <h1 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight leading-none">Keuangan Y &amp; D</h1>
                        <p class="text-[11px] text-slate-500 font-medium mt-0.5">Online Google Sheets Sync Enabled</p>
                    </div>
                </div>

                <div class="flex items-center gap-2 flex-wrap">
                    <button onclick="openEmailModal()" title="Klik untuk mengubah email device ini" class="flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition border border-slate-200">
                        <i class="fa-solid fa-user-gear text-emerald-600"></i>
                        <span id="headerEmailLabel" class="max-w-[120px] sm:max-w-[180px] truncate">Akun Perangkat</span>
                    </button>

                    <button onclick="openSheetsModal()" title="Atur Google Apps Script &amp; Sinkronisasi" class="flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded-lg text-xs font-semibold transition border border-emerald-200">
                        <i class="fa-solid fa-cloud-arrow-up text-emerald-600"></i>
                        <span>Google Sheets</span>
                    </button>

                    <button id="soundToggleBtn" onclick="toggleSound()" title="Aktifkan/Matikan Suara" class="p-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition border border-slate-200 flex items-center gap-1.5">
                        <i id="soundIcon" class="fa-solid fa-volume-high text-emerald-600"></i>
                        <span class="hidden sm:inline text-xs">Suara</span>
                    </button>

                    <div class="relative inline-block">
                        <button onclick="toggleThemeDropdown()" class="p-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition border border-slate-200 flex items-center gap-1.5">
                            <i class="fa-solid fa-palette text-indigo-600"></i>
                            <span class="hidden sm:inline text-xs">Menu &amp; Tema</span>
                        </button>
                        <div id="themeDropdown" class="hidden absolute right-0 mt-2 w-56 bg-white text-slate-800 rounded-xl shadow-xl border border-slate-200 p-2 z-50 text-xs">
                            <p class="font-bold text-slate-400 px-2 py-1 uppercase text-[10px]">Animasi Latar</p>
                            <button onclick="setBgTheme('snow')" class="w-full text-left px-2 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-sky-100 border"></span> ❄️ Salju Lembut</button>
                            <button onclick="setBgTheme('leaves')" class="w-full text-left px-2 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-emerald-100 border"></span> 🍃 Daun Gugur</button>
                            <button onclick="setBgTheme('rain')" class="w-full text-left px-2 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-100 border"></span> 🌧️ Hujan Rintik</button>
                            
                            <p class="font-bold text-slate-400 px-2 pt-2 pb-1 uppercase text-[10px] border-t border-slate-100 mt-1">Warna Latar</p>
                            <button onclick="setBgTheme('slate')" class="w-full text-left px-2 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-slate-100 border"></span> Default Slate</button>
                            <button onclick="setBgTheme('mint')" class="w-full text-left px-2 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-emerald-50 border"></span> Hijau Mint</button>
                            <button onclick="setBgTheme('blue')" class="w-full text-left px-2 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-sky-50 border"></span> Biru Muda</button>
                            <button onclick="setBgTheme('dark')" class="w-full text-left px-2 py-1.5 rounded hover:bg-slate-100 flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-slate-800 border"></span> Mode Gelap</button>
                            <div class="border-t border-slate-100 mt-1 pt-1 px-2">
                                <label class="block text-[10px] text-slate-500 font-semibold mb-1">Pilih Warna Custom:</label>
                                <input type="color" id="customColorPicker" onchange="setCustomBgTheme(this.value)" class="w-full h-7 rounded cursor-pointer border border-slate-300 p-0">
                            </div>

                            <div class="border-t border-slate-100 mt-2 pt-1.5 px-2">
                                <label class="block text-[10px] text-slate-500 font-semibold mb-1">Jeda Waktu Suara: <span id="delayLabel">350</span>ms</label>
                                <input type="range" id="soundDelayRange" min="100" max="1000" step="50" value="350" oninput="updateSoundDelay(this.value)" class="w-full accent-emerald-600 cursor-pointer">
                            </div>

                            <div class="border-t border-slate-100 mt-2 pt-1.5">
                                <button onclick="resetAllData()" class="w-full text-left px-2 py-2 rounded hover:bg-rose-50 text-rose-600 font-bold flex items-center gap-2 transition">
                                    <i class="fa-solid fa-rotate-right"></i> Reset Semua Data
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <main class="max-w-5xl mx-auto px-4 pt-6 pb-24 relative z-10 text-slate-800">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Saldo Total Saat Ini</span>
                        <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-scale-balanced"></i>
                        </div>
                    </div>
                    <h2 id="totalBalanceText" class="text-2xl font-bold text-slate-900 tracking-tight">Rp 0</h2>
                    <span class="text-[11px] text-slate-400 mt-1">Sisa Akumulasi Kas Aktif</span>
                </div>

                <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Pemasukan</span>
                        <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-arrow-down font-bold"></i>
                        </div>
                    </div>
                    <h2 id="totalIncomeText" class="text-2xl font-bold text-emerald-600 tracking-tight">Rp 0</h2>
                    <span class="text-[11px] text-emerald-700/60 mt-1 font-medium"><i class="fa-solid fa-circle-arrow-down"></i> Pemasukan Terdata</span>
                </div>

                <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Pengeluaran</span>
                        <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center text-sm">
                            <i class="fa-solid fa-arrow-up font-bold"></i>
                        </div>
                    </div>
                    <h2 id="totalExpenseText" class="text-2xl font-bold text-rose-600 tracking-tight">Rp 0</h2>
                    <span class="text-[11px] text-rose-700/60 mt-1 font-medium"><i class="fa-solid fa-circle-arrow-up"></i> Pengeluaran Terdata</span>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-6">
                <div class="flex bg-white p-1 rounded-xl border border-slate-200 text-xs font-semibold text-slate-600 shadow-sm overflow-x-auto">
                    <button onclick="switchTab('dashboard')" id="tabBtn-dashboard" class="px-4 py-2 rounded-lg bg-emerald-600 text-white transition shadow-xs">Dashboard</button>
                    <button onclick="switchTab('transactions')" id="tabBtn-transactions" class="px-4 py-2 rounded-lg hover:text-slate-900 transition">Riwayat Transaksi</button>
                    <button onclick="switchTab('budgets')" id="tabBtn-budgets" class="px-4 py-2 rounded-lg hover:text-slate-900 transition">Anggaran</button>
                    <button onclick="switchTab('goals')" id="tabBtn-goals" class="px-4 py-2 rounded-lg hover:text-slate-900 transition">Target Tabungan</button>
                    <button onclick="switchTab('deleted')" id="tabBtn-deleted" class="px-4 py-2 rounded-lg hover:text-slate-900 transition">Riwayat Hapus</button>
                </div>

                <div class="flex items-center gap-2">
                    <button onclick="syncToGoogleSheets()" title="Kirim data ke Google Sheets" class="px-3.5 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-xl border border-emerald-200 transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-rotate"></i> Sinkron Online
                    </button>
                    <button onclick="exportToCSV()" class="px-3.5 py-2 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-xl border border-slate-200 transition flex items-center gap-1.5 shadow-sm">
                        <i class="fa-solid fa-file-excel text-emerald-600"></i> Ekspor CSV
                    </button>
                    <button onclick="openTransactionModal()" class="flex-1 sm:flex-none px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-md shadow-emerald-200 transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-plus"></i> Transaksi Baru
                    </button>
                </div>
            </div>

            <div id="view-dashboard" class="space-y-6">
                <div class="bg-white rounded-2xl border border-slate-200/80 p-5 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-clock-rotate-left text-emerald-600"></i> Transaksi Terakhir
                        </h3>
                        <button onclick="switchTab('transactions')" class="text-xs text-emerald-600 hover:text-emerald-700 font-bold">Lihat Semua <i class="fa-solid fa-chevron-right text-[10px]"></i></button>
                    </div>
                    <div id="recentTransactionsList" class="divide-y divide-slate-100"></div>
                </div>
            </div>

            <div id="view-transactions" class="hidden space-y-4">
                <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-sm flex flex-col sm:flex-row items-center gap-3">
                    <div class="relative w-full sm:w-64">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                        <input type="text" id="searchInput" oninput="renderTransactions()" placeholder="Cari keterangan..." class="w-full pl-8 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:border-emerald-500">
                    </div>
                    <select id="filterType" onchange="updateFilterCategories(); renderTransactions()" class="w-full sm:w-auto px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:border-emerald-500 font-medium">
                        <option value="all">Semua Tipe</option>
                        <option value="income">Pemasukan</option>
                        <option value="expense">Pengeluaran</option>
                    </select>
                    <select id="filterCategory" onchange="renderTransactions()" class="w-full sm:w-auto px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:border-emerald-500 font-medium">
                        <option value="all">Semua Kategori</option>
                    </select>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="py-3 px-4">Tanggal (Tgl-Bln-Thn)</th>
                                    <th class="py-3 px-4">Kategori &amp; Catatan</th>
                                    <th class="py-3 px-4">Penginput</th>
                                    <th class="py-3 px-4 text-right">Nominal</th>
                                    <th class="py-3 px-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="transactionList" class="divide-y divide-slate-100 text-xs"></tbody>
                        </table>
                    </div>
                    <div id="emptyState" class="hidden p-8 text-center">
                        <div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-3 text-lg">
                            <i class="fa-solid fa-receipt"></i>
                        </div>
                        <p class="text-xs font-bold text-slate-700">Belum Ada Transaksi</p>
                        <p class="text-[11px] text-slate-400 mt-1">Gunakan tombol "Transaksi Baru" untuk mencatat keuangan Anda.</p>
                    </div>
                </div>
            </div>

            <div id="view-budgets" class="hidden space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">Batas Anggaran Bulanan</h3>
                        <p class="text-[11px] text-slate-500">Kendalikan pengeluaran agar sesuai dengan rencana.</p>
                    </div>
                    <button onclick="openBudgetModal()" class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold shadow-xs hover:bg-emerald-700 transition">
                        + Atur Anggaran
                    </button>
                </div>
                <div id="budgetList" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
            </div>

            <div id="view-goals" class="hidden space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">Target Tabungan &amp; Impian</h3>
                        <p class="text-[11px] text-slate-500">Rencanakan dana masa depan secara terukur.</p>
                    </div>
                    <button onclick="openGoalModal()" class="px-3 py-1.5 bg-emerald-600 text-white rounded-lg text-xs font-bold shadow-xs hover:bg-emerald-700 transition">
                        + Target Baru
                    </button>
                </div>
                <div id="goalList" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
            </div>

            <div id="view-deleted" class="hidden space-y-4">
                <div class="bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-sm p-4">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-trash-arrow-up text-rose-600"></i> Log Riwayat Penghapusan Transaksi
                        </h3>
                        <span class="text-xs text-slate-400">Tercatat otomatis beserta email penghapus</span>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-500 uppercase tracking-wider">
                                    <th class="py-3 px-4">Waktu Hapus</th>
                                    <th class="py-3 px-4">Keterangan &amp; Nominal</th>
                                    <th class="py-3 px-4">Dihapus Oleh (Email)</th>
                                    <th class="py-3 px-4">Penginput Asli</th>
                                </tr>
                            </thead>
                            <tbody id="deletedTransactionList" class="divide-y divide-slate-100 text-xs"></tbody>
                        </table>
                    </div>
                    <div id="emptyDeletedState" class="hidden p-8 text-center">
                        <div class="w-12 h-12 bg-slate-100 text-slate-400 rounded-full flex items-center justify-center mx-auto mb-3 text-lg">
                            <i class="fa-solid fa-shield-check"></i>
                        </div>
                        <p class="text-xs font-bold text-slate-700">Belum Ada Transaksi yang Dihapus</p>
                        <p class="text-[11px] text-slate-400 mt-1">Log penghapusan akan merekam email dan waktu setiap transaksi dihapus.</p>
                    </div>
                </div>
            </div>
        </main>

        <footer class="fixed bottom-0 left-0 right-0 z-40 bg-slate-950/85 backdrop-blur-md py-2.5 px-4 text-center border-t border-slate-800/50 shadow-2xl">
            <p class="text-xs text-slate-400 font-medium tracking-wide">PoweredBy © Achmadyunus979@gmail.com | Google Sheets Online Sync</p>
        </footer>
    </div>

    <div id="transactionModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4">
        <div class="bg-white text-slate-800 rounded-2xl max-w-md w-full max-h-[90vh] flex flex-col shadow-2xl modal-animate border border-slate-100 overflow-hidden">
            <div class="p-6 pb-3 flex items-center justify-between border-b border-slate-100 flex-shrink-0">
                <h3 class="text-base font-bold text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-pen-to-square text-emerald-600"></i> Catat Transaksi Baru
                </h3>
                <button onclick="closeTransactionModal()" class="text-slate-400 hover:text-slate-600 text-sm p-1">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="transactionForm" onsubmit="saveTransaction(event)" class="p-6 pt-3 space-y-4 overflow-y-auto flex-grow">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1.5">Jenis Transaksi <span class="text-rose-500">*</span></label>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" id="btnTypeIncome" onclick="setTransactionType('income')" class="py-2 rounded-xl border border-emerald-600 bg-emerald-50 text-emerald-700 font-bold text-xs flex items-center justify-center gap-2 transition">
                            <i class="fa-solid fa-circle-arrow-down"></i> Pemasukan
                        </button>
                        <button type="button" id="btnTypeExpense" onclick="setTransactionType('expense')" class="py-2 rounded-xl border border-slate-200 bg-slate-50 text-slate-600 font-bold text-xs flex items-center justify-center gap-2 transition">
                            <i class="fa-solid fa-circle-arrow-up"></i> Pengeluaran
                        </button>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">Nominal (Rp) <span class="text-rose-500">*</span></label>
                    <div class="relative">
                        <span class="absolute left-3 top-2.5 text-xs font-bold text-slate-400">Rp</span>
                        <input type="text" id="amountInput" inputmode="numeric" oninput="formatNumberInput(this); validateTransactionForm();" placeholder="0" class="w-full pl-10 pr-3 py-2 border border-slate-200 rounded-xl text-sm font-bold text-slate-800 focus:outline-none focus:border-emerald-500 bg-white">
                    </div>
                </div>


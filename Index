        function startBgAnimation(type) {
            stopBgAnimation();
            const canvas = document.getElementById('bgCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const particleCount = type === 'rain' ? 120 : 55;
            particles = [];

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    radius: type === 'snow' ? Math.random() * 3 + 1 : 0,
                    length: type === 'rain' ? Math.random() * 22 + 12 : 0,
                    size: type === 'leaves' ? Math.random() * 9 + 6 : 0,
                    speedY: type === 'snow' ? Math.random() * 1.2 + 0.6 : type === 'rain' ? Math.random() * 9 + 7 : Math.random() * 1.5 + 0.8,
                    speedX: type === 'snow' ? Math.sin(i) * 0.5 : type === 'leaves' ? Math.sin(i) * 1.2 + 0.5 : 0.5,
                    rotation: Math.random() * 360,
                    rotSpeed: Math.random() * 2 - 1
                });
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                if (type === 'snow') {
                    ctx.fillStyle = 'rgba(255, 255, 255, 0.85)';
                    particles.forEach(p => {
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                        ctx.fill();

                        p.y += p.speedY;
                        p.x += Math.sin(p.y * 0.01) * 0.5;

                        if (p.y > canvas.height) {
                            p.y = -10;
                            p.x = Math.random() * canvas.width;
                        }
                    });
                } else if (type === 'rain') {
                    ctx.strokeStyle = 'rgba(120, 200, 255, 0.65)';
                    ctx.lineWidth = 1.5;
                    particles.forEach(p => {
                        ctx.beginPath();
                        ctx.moveTo(p.x, p.y);
                        ctx.lineTo(p.x - 1, p.y + p.length);
                        ctx.stroke();

                        p.y += p.speedY;
                        p.x -= 0.5;

                        if (p.y > canvas.height) {
                            p.y = -20;
                            p.x = Math.random() * canvas.width;
                        }
                    });
                } else if (type === 'leaves') {
                    particles.forEach(p => {
                        ctx.save();
                        ctx.translate(p.x, p.y);
                        ctx.rotate((p.rotation * Math.PI) / 180);
                        ctx.fillStyle = 'rgba(52, 211, 153, 0.65)';
                        ctx.beginPath();
                        ctx.ellipse(0, 0, p.size, p.size / 2, 0, 0, Math.PI * 2);
                        ctx.fill();
                        ctx.restore();

                        p.y += p.speedY;
                        p.x += Math.sin(p.y * 0.02) * 1.2;
                        p.rotation += p.rotSpeed;

                        if (p.y > canvas.height) {
                            p.y = -20;
                            p.x = Math.random() * canvas.width;
                        }
                    });
                }

                animationFrameId = requestAnimationFrame(animate);
            }

            animate();
        }

        function stopBgAnimation() {
            if (animationFrameId) {
                cancelAnimationFrame(animationFrameId);
                animationFrameId = null;
            }
            const canvas = document.getElementById('bgCanvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');
                if (ctx) ctx.clearRect(0, 0, canvas.width, canvas.height);
            }
        }


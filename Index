    <script>
        function safeJsonParse(key, fallback) {
            try {
                const item = localStorage.getItem(key);
                if (!item || item === 'undefined' || item === 'null' || !item.trim()) return fallback;
                const parsed = JSON.parse(item);
                return parsed !== null && parsed !== undefined ? parsed : fallback;
            } catch (e) {
                console.warn(`Gagal membaca data localStorage untuk key "${key}":`, e);
                try {
                    localStorage.removeItem(key);
                } catch(_) {}
                return fallback;
            }
        }

        let transactions = safeJsonParse('kp_transactions', []);
        let deletedTransactions = safeJsonParse('kp_deleted_transactions', []);
        let budgets = safeJsonParse('kp_budgets', {
            'Makanan & Minuman': 1500000,
            'Hotel': 1000000,
            'Belanja': 1000000
        });
        let goals = safeJsonParse('kp_goals', [
            { id: 1, title: 'Dana Darurat', target: 10000000, saved: 0 }
        ]);

        const accountCredentials = {
            'DewiPurwanti.id': 'Dewi123',
            'AhmadYunus.id': 'Achmadyunus979'
        };

        let currentType = 'income';
        let currentUserEmail = localStorage.getItem('kp_user_email') || '';
        let soundEnabled = localStorage.getItem('kp_sound_enabled') !== 'false';
        let soundDelay = parseInt(localStorage.getItem('kp_sound_delay')) || 350;
        let googleScriptUrl = localStorage.getItem('kp_google_script_url') || '';
        let currentShareText = '';
        let currentPhotoBase64 = null;
        let loginAttemptCount = 0;

        let audioCtx = null;
        function getAudioContext() {
            if (!audioCtx) {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (AudioCtx) audioCtx = new AudioCtx();
            }
            if (audioCtx && audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function warmupTTS() {
            if ('speechSynthesis' in window) {
                try {
                    const silent = new SpeechSynthesisUtterance(' ');
                    silent.volume = 0;
                    window.speechSynthesis.speak(silent);
                } catch(e){}
            }
        }

        document.addEventListener('touchstart', function unlockAudio() {
            getAudioContext();
            warmupTTS();
        }, { once: true });

        document.addEventListener('click', function unlockAudio() {
            getAudioContext();
            warmupTTS();
        }, { once: true });

        const categories = {
            income: ['Tabungan', 'Bunga Seabank', 'Lainnya'],
            expense: ['Makanan & Minuman', 'Belanja', 'Tagihan & Utilitas', 'Kesehatan', 'Hotel', 'Lainnya']
        };

        function formatDate(dateStr) {
            if (!dateStr) return '-';
            if (dateStr.includes(',')) return dateStr;
            const parts = dateStr.split('-');
            if (parts.length === 3 && parts[0].length === 4) {
                return `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
            return dateStr;
        }

        function formatDateIndonesian(dateStr) {
            if (!dateStr) return '';
            const months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
            let day, monthIdx, year;
            const parts = dateStr.split('-');
            if (parts.length === 3) {
                if (parts[0].length === 4) {
                    year = parts[0];
                    monthIdx = parseInt(parts[1], 10) - 1;
                    day = parseInt(parts[2], 10);
                } else {
                    day = parseInt(parts[0], 10);
                    monthIdx = parseInt(parts[1], 10) - 1;
                    year = parts[2];
                }
                if (months[monthIdx]) {
                    return `${day} ${months[monthIdx]} ${year}`;
                }
            }
            return dateStr;
        }

        function updateSoundIcon() {
            const icon = document.getElementById('soundIcon');
            if (icon) {
                icon.className = soundEnabled ? "fa-solid fa-volume-high text-emerald-600" : "fa-solid fa-volume-xmark text-slate-400";
            }
        }

        window.toggleSound = function() {
            soundEnabled = !soundEnabled;
            localStorage.setItem('kp_sound_enabled', soundEnabled);
            updateSoundIcon();
            showToast(soundEnabled ? 'Suara diaktifkan' : 'Suara dimatikan');
        };

        function playSound(type) {
            if (!soundEnabled) return;
            try {
                const ctx = getAudioContext();
                if (!ctx) return;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);
                
                if (type === 'income') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, ctx.currentTime);
                    osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.08);
                    gain.gain.setValueAtTime(0.15, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.25);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.25);
                } else if (type === 'expense') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(440, ctx.currentTime);
                    osc.frequency.setValueAtTime(349.23, ctx.currentTime + 0.08);
                    gain.gain.setValueAtTime(0.15, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.25);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.25);
                } else if (type === 'warning') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(220, ctx.currentTime);
                    osc.frequency.setValueAtTime(150, ctx.currentTime + 0.12);
                    gain.gain.setValueAtTime(0.2, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.35);
                }
            } catch(e) {
                console.error("Audio error:", e);
            }
        }

        let cachedIndonesianVoice = null;
        function preloadIndonesianVoice() {
            if ('speechSynthesis' in window) {
                const voices = window.speechSynthesis.getVoices();
                if (voices.length > 0) {
                    cachedIndonesianVoice = voices.find(v => v.lang === 'id-ID' || v.lang.startsWith('id') || v.lang.includes('Indonesian')) || voices[0];
                }
            }
        }

        if ('speechSynthesis' in window) {
            preloadIndonesianVoice();
            window.speechSynthesis.onvoiceschanged = preloadIndonesianVoice;
        }

        function playQrisSound(callback) {
            if (!soundEnabled) {
                if (callback) callback();
                return;
            }
            try {
                const ctx = getAudioContext();
                if (!ctx) {
                    if (callback) callback();
                    return;
                }

                // Nada khas lonceng QRIS (A5 -> D6 -> A6)
                const notes = [
                    { freq: 880, time: 0, duration: 0.08 },
                    { freq: 1174.66, time: 0.07, duration: 0.1 },
                    { freq: 1760, time: 0.14, duration: 0.18 }
                ];

                notes.forEach(note => {
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(note.freq, ctx.currentTime + note.time);
                    
                    gain.gain.setValueAtTime(0.3, ctx.currentTime + note.time);
                    gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + note.time + note.duration);
                    
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    
                    osc.start(ctx.currentTime + note.time);
                    osc.stop(ctx.currentTime + note.time + note.duration);
                });

                if (callback) {
                    setTimeout(callback, soundDelay);
                }
            } catch (e) {
                console.error("QRIS Sound error:", e);
                if (callback) callback();
            }
        }

        window.updateSoundDelay = function(val) {
            soundDelay = parseInt(val);
            localStorage.setItem('kp_sound_delay', soundDelay);
            const lbl = document.getElementById('delayLabel');
            if (lbl) lbl.innerText = soundDelay;
        };

        function speakText(text, rate = 1.05) {
            if (!soundEnabled) return;
            if ('speechSynthesis' in window) {
                try {
                    // Paksa batalkan antrean sebelumnya agar langsung merespons
                    window.speechSynthesis.cancel();
                    
                    const utterance = new SpeechSynthesisUtterance(text);
                    utterance.lang = 'id-ID';
                    utterance.rate = rate; // Sedikit lebih cepat (1.05) agar gesit
                    utterance.pitch = 1.0;
                    
                    if (cachedIndonesianVoice) {
                        utterance.voice = cachedIndonesianVoice;
                    } else {
                        preloadIndonesianVoice();
                        if (cachedIndonesianVoice) utterance.voice = cachedIndonesianVoice;
                    }
                    
                    window.speechSynthesis.speak(utterance);
                } catch(e) {
                    console.error("SpeechSynthesis error:", e);
                }
            }
        }

        function terbilang(nilai) {
            nilai = Math.abs(Number(nilai) || 0);
            if (nilai === 0) return "nol";
            const angka = ["", "satu", "dua", "tiga", "empat", "lima", "enam", "tujuh", "delapan", "sembilan", "sepuluh", "sebelas"];
            let temp = "";
            if (nilai < 12) {
                temp = angka[nilai];
            } else if (nilai < 20) {

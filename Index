                        <td class="py-3 px-4 font-bold text-rose-600">${d.deletedByEmail}</td>
                        <td class="py-3 px-4 font-medium text-slate-600">${d.userEmail || 'Anonim'}</td>
                    </tr>
                `).join('');
            }
        };

        function compressImage(file, maxWidth, maxHeight, quality, callback) {
            const reader = new FileReader();
            reader.onload = function(event) {
                const img = new Image();
                img.onload = function() {
                    let width = img.width;
                    let height = img.height;

                    if (width > height) {
                        if (width > maxWidth) {
                            height = Math.round((height * maxWidth) / width);
                            width = maxWidth;
                        }
                    } else {
                        if (height > maxHeight) {
                            width = Math.round((width * maxHeight) / height);
                            height = maxHeight;
                        }
                    }

                    const canvas = document.createElement('canvas');
                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    if (ctx) {
                        ctx.drawImage(img, 0, 0, width, height);
                        const compressedDataUrl = canvas.toDataURL('image/jpeg', quality);
                        callback(compressedDataUrl);
                    } else {
                        callback(event.target.result);
                    }
                };
                img.onerror = function() {
                    callback(event.target.result);
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file);
        }

        function safeSaveTransactions(transactionsList) {
            try {
                localStorage.setItem('kp_transactions', JSON.stringify(transactionsList));
            } catch (e) {
                if (e.name === 'QuotaExceededError' || e.code === 22 || e.code === 1014) {
                    console.warn('LocalStorage full. Cleaning up older base64 photos...');
                    const pruned = transactionsList.map((t, idx) => {
                        if (idx > 3) {
                            return { ...t, photo: null };
                        }
                        return t;
                    });
                    try {
                        localStorage.setItem('kp_transactions', JSON.stringify(pruned));
                        showToast('Penyimpanan penuh. Foto transaksi lama otomatis dibersihkan.');
                    } catch (e2) {
                        const stripped = transactionsList.map((t, idx) => idx === 0 ? t : { ...t, photo: null });
                        try {
                            localStorage.setItem('kp_transactions', JSON.stringify(stripped));
                            showToast('Penyimpanan penuh. Menyimpan transaksi tanpa foto lama.');
                        } catch (e3) {
                            showToast('Gagal menyimpan data (Memori peramban penuh).');
                        }
                    }
                } else {
                    console.error('Error saving transactions:', e);
                }
            }
        }

        window.deleteTransaction = function(id) {
            if (!confirm("Yakin ingin menghapus transaksi ini?")) return;
            const idx = transactions.findIndex(t => t.id == id);
            if (idx !== -1) {
                const removed = transactions.splice(idx, 1)[0];
                deletedTransactions.unshift({
                    ...removed,
                    photo: null,
                    deletedAt: new Date().toLocaleString('id-ID'),
                    deletedByEmail: currentUserEmail || 'Anonim'
                });
                safeSaveTransactions(transactions);
                try {
                    localStorage.setItem('kp_deleted_transactions', JSON.stringify(deletedTransactions));
                } catch(e) {
                    console.warn('Could not save deleted log:', e);
                }
                renderAll();
                playSound('expense');
                const terbilangHapus = terbilang(removed.amount);
                speakText(`Transaksi ${removed.category} sebesar ${terbilangHapus} rupiah telah dihapus oleh ${currentUserEmail || 'Anonim'}`, 1.05);
                showToast('Transaksi dihapus');
                syncToGoogleSheets();
            }
        };

        window.switchTab = function(tabName) {
            ['dashboard', 'transactions', 'budgets', 'goals', 'deleted'].forEach(t => {
                const view = document.getElementById(`view-${t}`);
                const btn = document.getElementById(`tabBtn-${t}`);
                if (view) view.classList.add('hidden');
                if (btn) {
                    btn.className = "px-4 py-2 rounded-lg hover:text-slate-900 transition";
                }
            });

            const activeView = document.getElementById(`view-${tabName}`);
            const activeBtn = document.getElementById(`tabBtn-${tabName}`);
            if (activeView) activeView.classList.remove('hidden');
            if (activeBtn) {
                activeBtn.className = "px-4 py-2 rounded-lg bg-emerald-600 text-white transition shadow-xs";
            }
        };

        window.setTransactionType = function(type) {
            currentType = type;
            const btnInc = document.getElementById('btnTypeIncome');
            const btnExp = document.getElementById('btnTypeExpense');
            const catSelect = document.getElementById('categorySelect');

            if (type === 'income') {
                if (btnInc) btnInc.className = "py-2 rounded-xl border border-emerald-600 bg-emerald-50 text-emerald-700 font-bold text-xs flex items-center justify-center gap-2 transition";
                if (btnExp) btnExp.className = "py-2 rounded-xl border border-slate-200 bg-slate-50 text-slate-600 font-bold text-xs flex items-center justify-center gap-2 transition";
                if (catSelect) catSelect.innerHTML = categories.income.map(c => `<option value="${c}">${c}</option>`).join('');
            } else {
                if (btnExp) btnExp.className = "py-2 rounded-xl border border-rose-600 bg-rose-50 text-rose-700 font-bold text-xs flex items-center justify-center gap-2 transition";
                if (btnInc) btnInc.className = "py-2 rounded-xl border border-slate-200 bg-slate-50 text-slate-600 font-bold text-xs flex items-center justify-center gap-2 transition";
                if (catSelect) catSelect.innerHTML = categories.expense.map(c => `<option value="${c}">${c}</option>`).join('');
            }
            validateTransactionForm();
        };

        window.validateTransactionForm = function() {
            const amount = getRawNumber(document.getElementById('amountInput')?.value);
            const category = document.getElementById('categorySelect')?.value;
            const submitBtn = document.getElementById('submitTransactionBtn');

            if (!submitBtn) return;
            if (amount > 0 && category && currentPhotoBase64) {
                submitBtn.removeAttribute('disabled');
            } else {
                submitBtn.setAttribute('disabled', 'true');
            }
        };

        window.handlePhotoUpload = function(e) {
            const file = e.target.files[0];
            if (!file) return;

            compressImage(file, 800, 800, 0.6, function(compressedBase64) {
                currentPhotoBase64 = compressedBase64;
                const previewImg = document.getElementById('photoPreviewImg');
                const previewContainer = document.getElementById('photoPreviewContainer');
                const btnText = document.getElementById('photoBtnText');

                if (previewImg) previewImg.src = currentPhotoBase64;
                if (previewContainer) previewContainer.classList.remove('hidden');
                if (btnText) btnText.innerText = "Ganti Foto Bukti";
                validateTransactionForm();
            });
        };

        window.removePhoto = function() {
            currentPhotoBase64 = null;
            const photoInput = document.getElementById('photoInput');
            if (photoInput) photoInput.value = '';
            document.getElementById('photoPreviewContainer')?.classList.add('hidden');
            const photoBtnText = document.getElementById('photoBtnText');
            if (photoBtnText) photoBtnText.innerText = "Ambil Foto dari Kamera / Pilih Galeri";
            validateTransactionForm();
        };

        window.saveTransaction = function(e) {
            if (e) e.preventDefault();
            const amountInput = document.getElementById('amountInput');
            const categorySelect = document.getElementById('categorySelect');
            const descriptionInput = document.getElementById('descriptionInput');
            const dateInput = document.getElementById('dateInput');

            const amount = getRawNumber(amountInput?.value);
            const category = categorySelect?.value;
            const description = descriptionInput?.value || '';
            const date = dateInput?.value || new Date().toISOString().split('T')[0];

            if (!amount || !category || !currentPhotoBase64) {
                showToast('Mohon lengkapi nominal, kategori, dan foto bukti!');
                return;
            }

            const newT = {
                id: Date.now(),
                type: currentType,
                amount,
                category,
                description,
                date,
                photo: currentPhotoBase64,
                userEmail: currentUserEmail || 'Anonim'
            };

            transactions.unshift(newT);
            safeSaveTransactions(transactions);

            closeTransactionModal();
            renderAll();

            const jenisText = currentType === 'income' ? 'Pemasukan' : 'Pengeluaran';
            const terbilangNominal = terbilang(amount);
            const tglIndo = formatDateIndonesian(date);
            
            const speechDetails = `Transaksi ${jenisText} baru berhasil disimpan untuk tanggal ${tglIndo}. Kategori ${category}, dengan jumlah ${terbilangNominal} rupiah${description ? ', dengan keterangan ' + description : ''}, diinput oleh ${currentUserEmail || 'Anonim'}.`;

            playQrisSound(() => {
                speakText(speechDetails, 1.05);
            });

            showToast('Transaksi berhasil disimpan');

            let totalInc = 0;
            let totalExp = 0;
            transactions.forEach(t => {
                if (t.type === 'income') totalInc += Number(t.amount);
                else totalExp += Number(t.amount);
            });
            const currentBalance = totalInc - totalExp;

            const isIncome = currentType === 'income';
            const statusHeader = isIncome ? '🟢 *PEMASUKAN MASUK*' : '🔴 *PENGELUARAN KELUAR*';
            const ketText = description ? `${description} (${category})` : category;

            currentShareText = `📌 PENCATATAN TRANSAKSI BARU 📌\n` +
                `   📅 Tanggal: ${formatDate(date)}\n` +
                `   👤 Input by: ${currentUserEmail || 'Anonim'}\n\n` +
                `   ${statusHeader}\n` +
                `   * Nominal: ${formatRupiah(amount)}\n` +
                `   * Ket: ${ketText}\n\n` +
                `   💰 Saldo Total Saat Ini: ${formatRupiah(currentBalance)}\n\n` +
                `   _Dilaporkan via Web Keuangan Y & D_`;

            const previewBox = document.getElementById('whatsappPreviewBox');
            if (previewBox) previewBox.innerText = currentShareText;
            document.getElementById('whatsappShareModal')?.classList.remove('hidden');

            syncToGoogleSheets();
        };

        window.sendToWhatsApp = function() {
            const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(currentShareText)}`;
            window.open(url, '_blank');
            closeShareModal();
        };

        window.closeShareModal = function() {
            document.getElementById('whatsappShareModal')?.classList.add('hidden');
        };

        window.viewPhoto = function(base64) {
            const img = document.getElementById('fullPhotoImg');
            if (img) img.src = base64;
            document.getElementById('photoViewModal')?.classList.remove('hidden');
        };

        window.closePhotoModal = function() {
            document.getElementById('photoViewModal')?.classList.add('hidden');
        };

        window.openSheetsModal = function() {
            const input = document.getElementById('scriptUrlInput');
            if (input) input.value = googleScriptUrl;
            document.getElementById('sheetsModal')?.classList.remove('hidden');
        };

        window.closeSheetsModal = function() {
            document.getElementById('sheetsModal')?.classList.add('hidden');
        };

        window.saveScriptUrl = function() {
            const val = (document.getElementById('scriptUrlInput')?.value || '').trim();
            googleScriptUrl = val;
            localStorage.setItem('kp_google_script_url', val);
            closeSheetsModal();
            showToast('URL Google Apps Script disimpan');
            if (val) syncToGoogleSheets();
        };

        window.syncToGoogleSheets = async function() {
            if (!googleScriptUrl) return;
            try {
                await fetch(googleScriptUrl, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        action: 'sync',
                        transactions: transactions
                    })
                });
                showToast('Sinkronisasi Google Sheets berhasil');
            } catch (err) {
                console.error('Sync error:', err);
            }
        };

        window.exportToCSV = function() {
            if (transactions.length === 0) {
                showToast('Tidak ada data untuk diekspor');
                return;
            }
            let csv = 'ID,Tanggal,Pengguna,Jenis,Kategori,Keterangan,Nominal\n';
            transactions.forEach(t => {
                csv += `"${t.id}","${formatDate(t.date)}","${t.userEmail || 'Anonim'}","${t.type}","${t.category}","${t.description || ''}","${t.amount}"\n`;
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('href', url);
            a.setAttribute('download', `Keuangan_YD_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            showToast('File CSV berhasil diunduh');
        };

        window.onload = function() {
            try {
                updateEmailBadge();
                updateSoundIcon();
                applySavedBgTheme();

                const delayRange = document.getElementById('soundDelayRange');
                const delayLbl = document.getElementById('delayLabel');
                if (delayRange) delayRange.value = soundDelay;
                if (delayLbl) delayLbl.innerText = soundDelay;

                const filterCat = document.getElementById('filterCategory');
                if (filterCat) {
                    const allCategories = [...categories.income, ...categories.expense];
                    const uniqueCats = [...new Set(allCategories)];
                    uniqueCats.forEach(c => {
                        filterCat.innerHTML += `<option value="${c}">${c}</option>`;
                    });
                }

                if (currentUserEmail) {
                    document.getElementById('authGate')?.classList.add('hidden');
                    const mainApp = document.getElementById('mainAppContent');
                    if (mainApp) {
                        mainApp.classList.remove('hidden');
                        setTimeout(() => mainApp.classList.remove('opacity-0'), 50);
                    }
                } else {
                    document.getElementById('authGate')?.classList.remove('hidden');
                    document.getElementById('mainAppContent')?.classList.add('hidden');
                }

                renderAll();
            } catch(e) {
                console.error("Initialization error caught:", e);
            }
        };
    </script>
